{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "open-template",
  "version": "0.1.0",
  "identifier": "com.opentemplate.app",
  "build": {
    "frontendDist": "splash",
    "beforeDevCommand": "node scripts/prepare-desktop.mjs --dev",
    "beforeBuildCommand": "node scripts/prepare-desktop.mjs",
    "additionalWatchFolders": ["../server", "../shared"]
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'none'; object-src 'none'; base-uri 'none'",
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/node"],
    "resources": {"runtime/": "runtime/"},
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "macOS": {"minimumSystemVersion": "13.0"},
    "windows": {"webviewInstallMode": {"type": "downloadBootstrapper", "silent": true}}
  }
}
